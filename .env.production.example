# Variabel untuk aplikasi di Coolify (Environment Variables, bisa ditempel lewat Developer view).
# Isi nilai yang kosong; jangan di-commit setelah diisi.

APP_NAME="Asset Management"
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show (jalankan sekali di laptop, salin hasilnya)
APP_KEY=
APP_URL=https://asset.iqbalfhz.my.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Resource MySQL 9.7 di Coolify: host internal, nama database, user khusus aplikasi
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=asset_management
DB_USERNAME=asset_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Password awal akun administrator (min. 12 karakter, huruf dan angka). Hapus dari Coolify setelah login pertama.
SEED_PASSWORD=

# Cloudflare R2 untuk backup aplikasi
# R2_ENDPOINT: https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
BACKUP_DISKS=r2
# Arsip backup dienkripsi AES-256. Simpan kata sandi ini di tempat aman di luar server; tanpa itu backup tidak bisa dibuka.
BACKUP_ARCHIVE_PASSWORD=
# Kosongkan kalau dump database cukup lewat backup terjadwal Coolify.
BACKUP_DATABASES=mysql
BACKUP_NOTIFICATION_EMAIL=

# Email (opsional sampai Fase 12); log = tidak mengirim email
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Asset Management"
